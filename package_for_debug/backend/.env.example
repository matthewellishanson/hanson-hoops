# --- Backend env (no secrets here) ---
# Optional proxy for nba_api outbound calls (http://user:pass@host:port)
PROXY_URL=
NBA_STATS_PROXY=

# Optional: override UA used in requests
NBA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36

# If you ever lock CORS to a specific origin (comma-separated list)
CORS_ALLOW_ORIGINS=https://matthewellishanson.github.io

# Render sets PORT automatically; keep for local runs if you want
PORT=8000