**

# Preserve the historically deployed backend tree unless a file is conclusively
# development-only, generated junk, a backup, or unsafe to ship.
!backend/
!backend/**
backend/.dockerignore
backend/tests/
backend/requirements-dev.txt
backend/app/cache/rookie_snapshot.bak.*.csv

# Pair Fit v2 is a strict six-file allowlist. Keep each parent negation before
# its children; no other research file is re-included.
!research/
research/**
!research/pair-fit-v2/
research/pair-fit-v2/**
!research/pair-fit-v2/src/
research/pair-fit-v2/src/**
!research/pair-fit-v2/src/pair_fit_v2/
research/pair-fit-v2/src/pair_fit_v2/**
!research/pair-fit-v2/src/pair_fit_v2/__init__.py
!research/pair-fit-v2/src/pair_fit_v2/inference.py
!research/pair-fit-v2/production/
research/pair-fit-v2/production/**
!research/pair-fit-v2/production/pair-fit-v2.0.0/
research/pair-fit-v2/production/pair-fit-v2.0.0/**
!research/pair-fit-v2/production/pair-fit-v2.0.0/model.json
!research/pair-fit-v2/production/pair-fit-v2.0.0/artifact_manifest.json
!research/pair-fit-v2/production/pair-fit-v2.0.0/metadata.json
!research/pair-fit-v2/production/pair-fit-v2.0.0/player_profiles.csv

# Universal secrets, local environments, caches, and generated development
# artifacts. These follow the allowlists so they also override backend/**.
.git/
**/.git/
.venv/
**/.venv/
venv/
**/venv/
node_modules/
**/node_modules/
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
*.pyo
**/*.pyo
.pytest_cache/
**/.pytest_cache/
.pytest_tmp/
**/.pytest_tmp/
.tox/
**/.tox/
.nox/
**/.nox/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
**/.coverage
htmlcov/
**/htmlcov/
dist/
**/dist/
.vite/
**/.vite/
.env
**/.env
.env.*
**/.env.*
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.pfx
**/*.pfx
*.swp
**/*.swp
*.swo
**/*.swo
*~
**/*~
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
